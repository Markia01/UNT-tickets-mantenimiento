# Copia este archivo como .env.local y ajusta los valores.

# true = usa los datos de prueba de src/api/mocks; false = llama a la API de esta
# misma app (rutas /api/..., en src/app/api)
NEXT_PUBLIC_USE_MOCKS=true

# Conexión a MongoDB (solo la usa el servidor; no lleva NEXT_PUBLIC_)
# Atlas (nube):  mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/tickets_utn?retryWrites=true&w=majority
# Local:         mongodb://localhost:27017/tickets_utn
MONGODB_URI="mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/tickets_utn?retryWrites=true&w=majority"

# Clave secreta para firmar las sesiones (JWT). Larga y aleatoria; no la compartas.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
