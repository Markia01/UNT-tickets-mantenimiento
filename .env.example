# Copia este archivo como .env y llena tus propios valores.
# El archivo .env NUNCA se sube al repositorio.

# Puerto del servidor
PORT=3000

# Conexión a MongoDB
# Atlas (nube):  mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/tickets_utn
# Local:         mongodb://localhost:27017/tickets_utn
MONGODB_URI="mongodb://localhost:27017/tickets_utn"

# Clave para firmar las sesiones (usa una cadena larga y aleatoria)
SESSION_SECRET="cambia_esta_clave"

# URL pública de la aplicación (se usa dentro de los códigos QR)
APP_URL="http://localhost:3000"
